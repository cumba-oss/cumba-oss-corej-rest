#################
#
# Primary .gitignore for this multi-module Maven project.
# Define ignores that are common across most modules here.
#
#################

# Eclipse
**/.settings/
**/.project
**/.classpath

# IntelliJ
**/.idea/
**/*.iml

# VS Code
**/.vscode/

# Maven
**/target/

# Validation reports written into the working directory by the CLI / by tests.
# ⚠ The engine writes a per-rule runtime CSV beside the report, and the test
# cleanup only removed CORE-Report-*.json — so these accumulated untracked in the
# repository root and a `git add -A` would have committed them.
# ⚠ Anchored with a leading slash, like the other root-only rules in this file.
# Unanchored they would also swallow a golden-file fixture such as
# src/test/resources/.../CORE-Report-expected.json — silently, because `git add -A`
# does not warn about an ignored path.
/CORE-Report-*.json
/CORE-Report-*.runtime.csv
/CORE-Report-*.xlsx

# Pitest incremental-analysis history files (generated; cached by CI)
/.pitest-history/

# ---> Java
**/*.class

# Package files
**/*.jar
**/*.war
**/*.ear
**/*.dll
**/*.so
**/*.dylib

# OS-level cruft
**/.DS_Store
# JVM crash logs — see https://www.java.com/en/download/help/error_hotspot.xml
**/hs_err_pid*

# Claude Code working dir
**/.claude

# Generic build output
**/bin/
/build_logs/

# .env files (any module / sub-dir)
**/.env

# Python helper caches (if scripts/ uses them)
__pycache__/
.pytest_cache/

# flattened pom output (flatten-maven-plugin)
**/.flattened-pom.xml

# Locally resolved third-party licenses (regenerated by license-maven-plugin)
/src/license/licenses

# Define-XML conformance report output. JsonReportWriter names its output
# <input>.define.json and writes it beside the working directory, so an ad-hoc
# run drops one at a module root. A 39 KB report carrying a /tmp/junit-*
# path was committed this way on 2026-09-02 and shipped to a public repo.
**/*.define.json
