# coreJ REST — Docker Compose configuration.
#
# Copy this file to `.env` (which `docker compose` reads automatically) and edit.
# Every value is optional; docker-compose.yml falls back to these same defaults
# when a variable is unset.

# Published host port. REST API under /api, Swagger UI at /swagger-ui.html.
# ⚠ No UI at / — this build is API-only. The React SPA is a separate project and
# nothing in this repository can inline it into the jar.
COREJ_HTTP_PORT=8080

# Global cap on concurrently-running validation checks (extra runs queue as PENDING).
COREJ_RUNS_MAXPARALLEL=2

# In-memory parsed-report cache fronting the on-disk report JSON.
COREJ_REPORTS_CACHE_TTL=30m
COREJ_REPORTS_CACHE_MAXENTRIES=64

# Max upload size per file and per request (study datasets can be large).
COREJ_MAX_UPLOAD=512MB

# Seed the unified CDISC metadata store once at startup (corej.cache-seed.enabled).
# Off by default: it is outbound network I/O that takes minutes, so it is opt-in.
# With no store the service still runs — every library-dependent rule SKIPs,
# loudly and by name.
#
# The store is a single zip file on the bind mount, ./corej-data/metadata-cache.zip
# (/app/data/metadata-cache.zip in the container, set in docker-compose.yml), so it
# survives `docker compose up --build`. Nothing creates it for you: either seed it
# with the two settings here, or drop a store file in yourself.
# ⚠ A pre-existing ./corej-data/api-cache is the RETIRED web-API cache: nothing
# reads it, and the container says so once at startup. Delete it after seeding the
# store.
COREJ_CACHESEED_ENABLED=false

# Seed from the live CDISC Library API instead of the published pickle metadata
# (corej.cache-seed.from-api). Needs CDISC_API_KEY below, and is mutually
# exclusive with a local pickle directory (corej.cache-seed.from-dir).
COREJ_CACHESEED_FROMAPI=false

# CDISC Library API key. Optional; blank means Library enrichment is skipped,
# which can leave rules SKIPPED.
CDISC_API_KEY=

# Opt in to downloading the credential-free dictionary trio (MED-RT, UNII,
# neoplasm) on start. ⚠ This image bakes no installer, so today this only produces
# a warning — install with the cumba-oss-corej-cli image against the same
# ./corej-data volume.
COREJ_DICTIONARY_AUTO_INSTALL=0

# Extra JVM options, e.g. -Xmx2g.
JAVA_TOOL_OPTIONS=

# Base images used by the build.
MAVEN_IMAGE=maven:3.9-eclipse-temurin-25
RUNTIME_IMAGE=eclipse-temurin:25-jre
